# Environment Variables for Generative UI Builder

# Anthropic API Key (required for Claude VLM)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# E2B API Key (for code interpreter sandbox)
E2B_API_KEY=your_e2b_api_key_here

# Optional: Custom sandbox timeout (in ms)
SANDBOX_TIMEOUT=30000

# Optional: Maximum iterations for self-healing loop
MAX_HEALING_ITERATIONS=5
